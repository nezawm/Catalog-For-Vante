# این فایل را کپی کنید: cp .env.example .env  و مقدارها را پر کنید. فایل .env را هرگز commit نکنید.

# کلید مخفی جنگو (اجباری). ساخت کلید جدید:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# روی سرور حتماً False باشد. فقط برای توسعهٔ محلی True بگذارید.
DJANGO_DEBUG=False

# دامنه‌های مجاز، جداشده با کاما (روی سرور اجباری است)
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# اختیاری
# پشت nginx/پروکسی که X-Forwarded-For را خودش مقداردهی می‌کند True کنید
LOG_TRUST_PROXY_HEADER=False
# شمارهٔ تماس فوتر سایت
CONTACT_PHONE=011-3514
